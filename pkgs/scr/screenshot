#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: screenshot <start|watch|fullscreen|region|quit>" >&2
    exit 2
}

case "${1:-start}" in
start | watch | fullscreen | region | quit) mode="${1:-start}" ;;
*) usage ;;
esac

shell_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
shell_file="$shell_dir/shell.qml"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/scr"
config_file="$config_dir/config.toml"

if [ ! -f "$config_file" ]; then
    mkdir -p "$config_dir"
    cp "$shell_dir/config.example.toml" "$config_file"
fi

daemon_running() {
    qs -p "$shell_file" ipc show >/dev/null 2>&1
}

start_daemon() {
    daemon_running && return 0

    # --no-duplicate keeps a race from spawning a second picker.
    qs -p "$shell_file" --no-duplicate --daemonize

    for _ in $(seq 1 200); do
        daemon_running && return 0
        sleep 0.05
    done

    echo "screenshot: the background instance did not come up" >&2
    return 1
}

ipc() {
    qs -p "$shell_file" ipc call screenshot "$@"
}

case "$mode" in
start)
    start_daemon
    echo "screenshot: running in background"
    ;;
watch)
    # Supervise the picker for the whole session: keep it warm and bring it back
    # if it dies or stops answering, so a keybind press never hits a cold start.
    start_daemon || true
    fails=0
    while sleep 15; do
        if daemon_running; then
            fails=0
            continue
        fi
        fails=$((fails + 1))
        if [ "$fails" -lt 2 ]; then
            continue
        fi
        fails=0
        qs -p "$shell_file" kill >/dev/null 2>&1 || true
        start_daemon || true
    done
    ;;
quit)
    ipc quit 2>/dev/null || true
    ;;
*)
    # The daemon is normally already up (started at login, see the hyprland
    # module). Only pay for the probe and a cold start when the call finds
    # nothing to talk to.
    if ! ipc "$mode" 2>/dev/null; then
        start_daemon
        ipc "$mode"
    fi
    ;;
esac
